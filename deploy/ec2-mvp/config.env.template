# =============================================================================
# config.env.template
# Copy this file to config.env and fill in your values.
# config.env is .gitignored — never commit it.
#
#   cp config.env.template config.env
#   nano config.env
# =============================================================================

# ── AWS ───────────────────────────────────────────────────────────────────────

# AWS region to deploy into
AWS_REGION=us-east-1

# Name prefix for all AWS resources (EC2, RDS, Security Groups, etc.)
APP_NAME=ubertool

# Amazon Machine Image — Ubuntu 24.04 LTS in us-east-1
# Find latest for your region: https://cloud-images.ubuntu.com/locator/ec2/
AMI_ID=ami-0e86e20dae9224db8

# Name of your EC2 key pair (must already exist in your AWS account)
# Create at: AWS Console → EC2 → Key Pairs
KEY_PAIR_NAME=ubertool-keypair

# Path to your private key file on this machine
SSH_KEY_PATH=~/.ssh/ubertool-keypair.pem

# ── Domain & TLS ──────────────────────────────────────────────────────────────

# Your domain name (A-record must point to the Elastic IP before TLS setup)
DOMAIN=api.yourdomain.com

# Email for Let's Encrypt expiry notifications
CERTBOT_EMAIL=your-email@example.com

# ── gRPC ──────────────────────────────────────────────────────────────────────

# Port the gRPC server listens on
# 443 works everywhere (no firewall issues for mobile clients)
# 50051 is gRPC standard but may be blocked on some networks
GRPC_PORT=443

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL database name (created on RDS)
DB_NAME=ubertool

# RDS master username
DB_USER=ubertool_admin

# RDS master password — use a strong password, min 8 chars, no @ or /
DB_PASSWORD=CHANGE_ME_strong_password_here
